# Duka Assistant. Placeholders only. Never put real values in this file.
DUKA_DARAJA_MODE=mock
# Sandbox env file path (read only in sandbox mode). Leave empty to use the
# default, ~/.secrets/duka-daraja-sandbox.env.
DUKA_DARAJA_ENV_FILE=
DUKA_MOCK_DELAY_MS=3000
# Optional: require ?secret=... on the callback URL.
DUKA_CALLBACK_SECRET=

# Keys that belong in the sandbox env file (not here):
# DARAJA_ENV=sandbox
# DARAJA_CONSUMER_KEY=<placeholder>
# DARAJA_CONSUMER_SECRET=<placeholder>
# DARAJA_SHORTCODE=<placeholder>
# DARAJA_PASSKEY=<placeholder>
# DARAJA_CALLBACK_URL=<optional https url>

# Planner (Claude). Leave DUKA_ALLOW_LIVE unset until Ian sets a spend cap.
ANTHROPIC_API_KEY=
DUKA_PLANNER=regex
# DUKA_PLANNER_CLIENT=mock
# DUKA_ALLOW_LIVE=1
