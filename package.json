{
  "name": "duka-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.cjs && node e2e/assistant.cjs && node e2e/claude.cjs",
    "spend": "tsx --conditions=react-server scripts/ledger-cli.ts report",
    "ledger:seed": "tsx --conditions=react-server scripts/ledger-cli.ts seed",
    "check:bundle": "node scripts/check-client-bundle.cjs .next/static",
    "smoke:sandbox": "tsx scripts/sandbox-smoke.ts"
  },
  "dependencies": {
    "@a2ui/react": "0.16.1",
    "@a2ui/web_core": "0.16.1",
    "@anthropic-ai/sdk": "^1.14.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.6"
}
